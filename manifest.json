{
  "manifest_version": 3,
  "name": "OTT Helper",
  "version": "1.0",
  "description": "Enhances User experience on OTT platforms.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.netflix.com/*",
    "https://www.primevideo.com/*",
    "https://www.hotstar.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*",
        "https://www.primevideo.com/*",
        "https://www.hotstar.com/*"
      ],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ]
}